{
  "name": "barrefree",
  "version": "0.0.0",
  "private": true,
  "description": "Turn songs into barre-free acoustic guitar chords and tabs.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:contracts": "pnpm --filter @barrefree/contracts generate",
    "dev": "pnpm --filter @barrefree/web dev",
    "build": "pnpm --filter @barrefree/web build",
    "check:contracts": "pnpm --filter @barrefree/contracts generate --check",
    "check:analyzer": "cd services/analyzer && uv run ruff check . && uv run ruff format --check . && uv run mypy && uv run pytest -q",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm check:contracts && pnpm check:analyzer"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-i18next": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
