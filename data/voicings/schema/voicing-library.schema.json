{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leffloard/guitartune/schemas/voicing-library.schema.json",
  "title": "VoicingLibrary",
  "description": "Guitar chord shapes. Arrays are indexed by string from the low E string (index 0 = 6th string) to the high E string (index 5). Frets are relative to the nut or capo: null = muted, 0 = open. Barres, base fret and tags are derived from the frets and fingers, never stored.",
  "type": "object",
  "required": ["tuning", "voicings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "tuning": { "const": "standard" },
    "source": {
      "description": "Provenance of generated files.",
      "type": "object",
      "required": ["name", "url", "commit", "license"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string" }
      }
    },
    "voicings": {
      "type": "array",
      "items": { "$ref": "#/$defs/voicing" }
    }
  },
  "$defs": {
    "voicing": {
      "type": "object",
      "required": ["chord", "frets"],
      "additionalProperties": false,
      "properties": {
        "chord": {
          "description": "Chord symbol the shape plays, e.g. \"Fmaj7\", \"C/E\".",
          "type": "string",
          "minLength": 1
        },
        "frets": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 24 }, { "type": "null" }]
          }
        },
        "fingers": {
          "description": "1 = index … 4 = pinky; null for open/muted strings or unknown. Omit to derive automatically.",
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 4 }, { "type": "null" }]
          }
        },
        "note": { "type": "string" }
      }
    }
  }
}
