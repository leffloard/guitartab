{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leffloard/guitartab/schemas/analysis.schema.json",
  "$defs": {
    "AnalysisMeta": {
      "additionalProperties": false,
      "properties": {
        "recognizer": {
          "description": "Chord recognizer implementation, e.g. 'chordino'.",
          "type": "string"
        },
        "separated": {
          "description": "Whether source separation ran before chord recognition.",
          "type": "boolean"
        },
        "processingSec": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "recognizer",
        "separated",
        "processingSec"
      ],
      "title": "AnalysisMeta",
      "type": "object"
    },
    "ChordSegment": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "description": "Start time in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "end": {
          "description": "End time in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "label": {
          "description": "Chord label in Harte syntax, e.g. 'C:maj', 'A:min7', 'G:7/3', 'N'.",
          "examples": [
            "A:min",
            "G:7/3",
            "N"
          ],
          "minLength": 1,
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "start",
        "end",
        "label",
        "confidence"
      ],
      "title": "ChordSegment",
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "properties": {
        "tonic": {
          "examples": [
            "A",
            "F#",
            "Bb"
          ],
          "pattern": "^[A-G](#|b)?$",
          "type": "string"
        },
        "mode": {
          "enum": [
            "major",
            "minor"
          ],
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "tonic",
        "mode",
        "confidence"
      ],
      "title": "Key",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "description": "Start time in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "end": {
          "description": "End time in seconds.",
          "minimum": 0,
          "type": "number"
        },
        "midi": {
          "maximum": 127,
          "minimum": 0,
          "type": "integer"
        },
        "velocity": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "start",
        "end",
        "midi",
        "velocity"
      ],
      "title": "Note",
      "type": "object"
    },
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "detail"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "Features": {
      "additionalProperties": false,
      "properties": {
        "urlImport": {
          "type": "boolean"
        },
        "recognizers": {
          "description": "Chord recognizers, the default first.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "separation": {
          "description": "Whether jobs may ask for source separation.",
          "type": "boolean"
        },
        "maxUploadMb": {
          "type": "integer"
        },
        "maxDurationSec": {
          "type": "integer"
        }
      },
      "required": [
        "urlImport",
        "recognizers",
        "separation",
        "maxUploadMb",
        "maxDurationSec"
      ],
      "title": "Features",
      "type": "object"
    },
    "Health": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "features": {
          "$ref": "#/$defs/Features"
        }
      },
      "required": [
        "status",
        "version",
        "features"
      ],
      "title": "Health",
      "type": "object"
    },
    "JobCreated": {
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "type": "string"
        }
      },
      "required": [
        "jobId"
      ],
      "title": "JobCreated",
      "type": "object"
    },
    "JobInfo": {
      "additionalProperties": false,
      "description": "State of an analysis job; ``result`` is set once the job is done.",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "done",
            "failed"
          ],
          "type": "string"
        },
        "stage": {
          "enum": [
            "queued",
            "decoding",
            "separating",
            "beats",
            "key",
            "chords",
            "notes",
            "done",
            "failed"
          ],
          "type": "string"
        },
        "progress": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/JobSource"
        },
        "options": {
          "$ref": "#/$defs/JobOptions"
        },
        "createdAt": {
          "description": "Unix time, seconds.",
          "type": "number"
        },
        "updatedAt": {
          "description": "Unix time, seconds.",
          "type": "number"
        },
        "expiresAt": {
          "description": "When the server deletes the job and its audio.",
          "type": "number"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "status",
        "stage",
        "progress",
        "error",
        "source",
        "options",
        "createdAt",
        "updatedAt",
        "expiresAt",
        "result"
      ],
      "title": "JobInfo",
      "type": "object"
    },
    "JobOptions": {
      "additionalProperties": false,
      "properties": {
        "recognizer": {
          "default": "chordino",
          "description": "Chord recognizer to use.",
          "type": "string"
        },
        "separate": {
          "default": false,
          "description": "Run source separation first (slow).",
          "type": "boolean"
        },
        "transcribe": {
          "default": false,
          "description": "Transcribe notes for the tab mode.",
          "type": "boolean"
        }
      },
      "required": [
        "recognizer",
        "separate",
        "transcribe"
      ],
      "title": "JobOptions",
      "type": "object"
    },
    "JobSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "upload",
            "url"
          ],
          "type": "string"
        },
        "name": {
          "description": "File name or track title, for display only.",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "name",
        "url"
      ],
      "title": "JobSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raw analysis of one audio file.",
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "type": "integer"
    },
    "durationSec": {
      "minimum": 0,
      "type": "number"
    },
    "tempoBpm": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timeSignature": {
      "anyOf": [
        {
          "pattern": "^\\d+/\\d+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "examples": [
        "4/4"
      ]
    },
    "key": {
      "anyOf": [
        {
          "$ref": "#/$defs/Key"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "beats": {
      "description": "Beat times in seconds.",
      "items": {
        "type": "number"
      },
      "type": "array"
    },
    "downbeats": {
      "description": "Times of the first beat of each bar, in seconds.",
      "items": {
        "type": "number"
      },
      "type": "array"
    },
    "chords": {
      "items": {
        "$ref": "#/$defs/ChordSegment"
      },
      "type": "array"
    },
    "notes": {
      "description": "Transcribed notes (only for the tab mode).",
      "items": {
        "$ref": "#/$defs/Note"
      },
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/AnalysisMeta"
    }
  },
  "required": [
    "version",
    "durationSec",
    "tempoBpm",
    "timeSignature",
    "key",
    "beats",
    "downbeats",
    "chords",
    "notes",
    "meta"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
