# Copy to .env and adjust. Never commit .env. Every line is optional.
BARREFREE_PORT=8000

# What the server offers. Parts whose model weights are missing are left out on their own.
# RECOGNIZERS=chordino,btc
# SEPARATION=true
# TRANSCRIPTION=true
# BEAT_TRACKER=beat_this

# Limits for uploads and the job queue.
MAX_UPLOAD_MB=50
MAX_DURATION_SEC=900
# TEMP_FILE_TTL_SEC=21600
# MAX_PENDING_JOBS=20
# UPLOAD_RATE_PER_MIN=6
# A running job with no progress for this long is failed:
# JOB_TIMEOUT_SEC=3600
# WORKER_POLL_INTERVAL_SEC=1

# Memory limits of the containers (docs/benchmarks.md: a 15-minute song peaks at about 2.0 GB
# with the defaults and 2.4 GB with separation and notes).
# API_MEMORY_LIMIT=1g
# WORKER_MEMORY_LIMIT=4g
# How long a stopping worker may finish its current job.
# WORKER_STOP_GRACE=2m

# Off by default: importing from YouTube/Spotify links is the user's responsibility (platform ToS).
ENABLE_URL_IMPORT=false
# YouTube asks many data-center servers to sign in. If link import fails with "YouTube refused
# this server", put a cookies.txt of a signed-in session in the data volume (read the risks
# in docs/architecture.md, section 4c, first) and point to it:
# URL_IMPORT_COOKIES=/data/youtube-cookies.txt

# Only needed with `docker compose --profile tunnel up`.
CLOUDFLARE_TUNNEL_TOKEN=
# Include the tunnel in every `docker compose` command without --profile:
# COMPOSE_PROFILES=tunnel
# If the server's firewall blocks UDP 7844 (QUIC), make cloudflared use HTTP/2 over TCP 7844:
# TUNNEL_TRANSPORT_PROTOCOL=http2
# With the tunnel, rate-limit uploads per visitor rather than per cloudflared container.
# Set it only behind a proxy that overwrites the header: clients could forge it otherwise.
# CLIENT_IP_HEADER=CF-Connecting-IP

# Optional: pull base images from a mirror if Docker Hub rate-limits you.
# NODE_IMAGE=mirror.gcr.io/library/node:24-slim
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim-trixie
